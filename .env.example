# --- Base de dados (a MESMA do bot: copia os valores das variáveis do serviço do bot) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASS=
MYSQL_DB=

# --- Discord OAuth2 (Developer Portal > OAuth2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Tem de estar igual em OAuth2 > Redirects. Ex.: https://loja.teudominio.com/auth/callback
DISCORD_REDIRECT_URI=

# --- Site ---
SITE_URL=https://loja.teudominio.com
# texto aleatório comprido (ex.: 40+ caracteres)
SESSION_SECRET=
# IDs do Discord dos administradores da loja, separados por vírgula
ADMIN_DISCORD_IDS=

# --- Pagamento ---
# manual = o jogador paga e um admin aprova | webhook = o gateway avisa o site sozinho
PAYMENT_MODE=manual
# Segredo partilhado com o gateway (assinatura HMAC-SHA256 do corpo, cabeçalho X-Signature)
PAYMENT_WEBHOOK_SECRET=
# Número do Multicaixa Express que recebe os pagamentos (já vem 930074068 por defeito)
PAY_EXPRESS_NUMBER=930074068
